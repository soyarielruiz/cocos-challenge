{
  "name": "cocos-challenge-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "db:baseline": "prisma db execute --file prisma/migrations/20261023000000_normalize_schema/migration.sql && prisma migrate resolve --applied 20261023000000_normalize_schema",
    "db:local:up": "docker compose up -d postgres",
    "db:local:down": "docker compose down",
    "db:validate": "node scripts/prisma.js validate",
    "db:migrate": "node scripts/prisma.js migrate deploy",
    "db:seed": "node scripts/prisma.js db seed",
    "test:db": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand test/integration/database-contract.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ],
    "coverageThreshold": {
      "src/features/**/execute.js": {
        "lines": 80
      },
      "src/features/orders/create-order/*executor.js": {
        "lines": 80
      },
      "src/shared/policies/**/*.js": {
        "lines": 80
      }
    }
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "pino": "^9.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^60.8.3",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1"
  }
}
